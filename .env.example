TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=it_podcast_bot
DATABASE_URL=sqlite:///data/it_podcast_bot.sqlite3
LOG_LEVEL=INFO
DEFAULT_LIMIT_PER_CHANNEL=20
TELEGRAM_CHANNELS_FILE=config/channels.txt
TELEGRAM_PUBLISH_CHANNEL_ID=
PUBLISH_TELEGRAM_ON_FINAL=false
PODCAST_TITLE=НикКаст
PODCAST_TARGET_MINUTES=12
PODCAST_SCRIPT_WORDS_PER_MINUTE=125
PODCAST_EDITORIAL_BRIEF="Содержательные изменения цифровых технологий, их устройства и применения; без рекламы и бытового шума."
RESEARCH_ENABLED=true
PODCAST_COVER_IMAGE=assets/nikcast_cover_256.jpg
EXCLUDE_KEYWORDS_FILE=config/exclude_keywords.txt
SOURCE_WEIGHTS_FILE=config/source_weights.txt
# 0 reads the complete lookback window; positive values explicitly cap collection.
FINAL_COLLECT_LIMIT=0
FINAL_POOL_LIMIT=250
FINAL_TOP_POSTS=5
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# ollama (default), or a text-only llama.cpp OpenAI-compatible server.
LOCAL_LLM_ENGINE=ollama
# Native mode requires a private LLM_API_KEY and one complete local GGUF.
# Set all LLM_*MODEL aliases to LLM_MODEL when using this single-model server.
# LLAMA_CPP_MODEL_PATH=/absolute/path/model.gguf
# LLAMA_CPP_EXECUTABLE=data/runtime/ollama/lib/ollama/llama-server
# Optional full path to the CUDA backend library for separately packaged builds.
# LLAMA_CPP_BACKEND_LIBRARY=/absolute/path/libggml-cuda.so
# Optional template for GGUF files without correct chat metadata; must exist.
# LLAMA_CPP_CHAT_TEMPLATE_FILE=/absolute/path/chat-template.jinja
# Optional hardware tuning; omitted uses the server's automatic defaults.
# LLAMA_CPP_GPU_LAYERS=0
# LLAMA_CPP_THREADS=4
LLAMA_CPP_DEVICE=auto
LLAMA_CPP_REASONING_BUDGET=1024
LLAMA_CPP_IDLE_SLEEP_SECONDS=10
LLM_MODEL=qwen2.5:7b-instruct
LLM_FAST_MODEL=qwen2.5:3b-instruct
LLM_FINAL_MODEL=qwen2.5:7b-instruct
LLM_SCRIPT_TEMPERATURE=0.25
LLM_SCRIPT_EDITOR_ENABLED=true
# Experimental extra review. Validate its precision on your model before enabling:
# local trials produced false positives. The mandatory source audit stays enabled.
LLM_SCENE_CRITIC_ENABLED=false
# Optional reasoning override for this review; empty inherits LLM_REASONING_EFFORT.
# LLM_SOURCE_REVIEW_REASONING_EFFORT=
LLM_EPISODE_PLAN_ENABLED=false
LLM_CHUNKED_SCRIPT_ENABLED=true
LLM_CHUNKED_MODEL=qwen2.5:7b-instruct
LLM_SCRIPT_CHUNK_SIZE=1
LLM_REQUEST_TIMEOUT_SECONDS=360
LLM_EDITORIAL_BATCH_SIZE=8
LLM_FACTCHECK_BATCH_SIZE=4
# Optional stronger local model for the final source-based acceptance check.
# LLM_EDITORIAL_REVIEW_MODEL=
# Optional for thinking-capable models; leave empty for the server default.
# LLM_REASONING_EFFORT=none
# Optional subset of configured character keys; omitted means all characters.
# PODCAST_PARTICIPANTS=mark,gleb,nika
PODCAST_STYLE_GUIDE_FILE=config/podcast_style.md
OLLAMA_CONTEXT_LENGTH=8192
# OLLAMA_EXECUTABLE=data/runtime/ollama/bin/ollama
OLLAMA_MEMORY_MAX_MB=4096
OLLAMA_SWAP_MAX_MB=256
# Disable extra host-memory prompt caches; scene recovery uses files instead.
OLLAMA_PROMPT_CACHE_MB=0
OLLAMA_CONTEXT_CHECKPOINTS=0
# Minimum spacing between bounded recurrent/SWA snapshots, in tokens.
OLLAMA_CHECKPOINT_MIN_STEP=8192
LLM_RELEASE_BEFORE_TTS=true
TTS_VOICE=ru
TTS_SPEED=160
TTS_PROVIDER=silero
TTS_OUTPUT_DIR=data/audio
TTS_SAMPLE_RATE=48000
TTS_DEVICE=cpu
TTS_CPU_THREADS=4
SILERO_MODEL_ID=v5_6_ru
# Optional local torch.package file; missing configured files fail without downloading.
# SILERO_MODEL_PATH=data/models/silero/v5_6_ru.pt
# Resolve foreign names and abbreviations with the local LLM before unloading it.
TTS_AUTO_PRONUNCIATION=false
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_LANGUAGE=ru
XTTS_VOICE_REFS_DIR=data/voices/xtts
# COQUI_TOS_AGREED=1
# XTTS_MARK_VOICE=data/voices/xtts/mark.wav
# XTTS_GLEB_VOICE=data/voices/xtts/gleb.wav
# XTTS_NIKA_VOICE=data/voices/xtts/nika.wav
# XTTS_ARTEM_VOICE=data/voices/xtts/artem.wav
AUDIO_BACKGROUND_MUSIC=false
AUDIO_BACKGROUND_MUSIC_VOLUME=0.08
# AUDIO_BACKGROUND_MUSIC_PATH=data/audio/music/chill_loop.wav

# Optional: Telegram connection through SOCKS proxy
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:2080
# TELEGRAM_PROXY_URL=socks5://username:password@127.0.0.1:2080

# Optional: comma-separated override for config/channels.txt
# TELEGRAM_CHANNELS=durov,pythonetc
