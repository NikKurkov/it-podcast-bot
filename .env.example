TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=it_podcast_bot
DATABASE_URL=sqlite:///data/it_podcast_bot.sqlite3
LOG_LEVEL=INFO
DEFAULT_LIMIT_PER_CHANNEL=20
TELEGRAM_CHANNELS_FILE=config/channels.txt
TELEGRAM_PUBLISH_CHANNEL_ID=
PUBLISH_TELEGRAM_ON_FINAL=false
PODCAST_TITLE=НикКаст
PODCAST_COVER_IMAGE=assets/nikcast_cover_256.jpg
EXCLUDE_KEYWORDS_FILE=config/exclude_keywords.txt
SOURCE_WEIGHTS_FILE=config/source_weights.txt
FINAL_COLLECT_LIMIT=20
FINAL_POOL_LIMIT=50
FINAL_TOP_POSTS=5
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_FAST_MODEL=qwen2.5:3b-instruct
LLM_FINAL_MODEL=qwen2.5:7b-instruct
LLM_SCRIPT_EDITOR_ENABLED=true
LLM_CHUNKED_SCRIPT_ENABLED=true
LLM_CHUNKED_MODEL=qwen2.5:3b-instruct
LLM_SCRIPT_CHUNK_SIZE=3
LLM_REQUEST_TIMEOUT_SECONDS=360
OLLAMA_CONTEXT_LENGTH=8192
TTS_VOICE=ru
TTS_SPEED=160
TTS_PROVIDER=silero
TTS_OUTPUT_DIR=data/audio
TTS_SAMPLE_RATE=48000
TTS_DEVICE=cpu
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_LANGUAGE=ru
XTTS_VOICE_REFS_DIR=data/voices/xtts
# COQUI_TOS_AGREED=1
# XTTS_MARK_VOICE=data/voices/xtts/mark.wav
# XTTS_GLEB_VOICE=data/voices/xtts/gleb.wav
# XTTS_NIKA_VOICE=data/voices/xtts/nika.wav
# XTTS_ARTEM_VOICE=data/voices/xtts/artem.wav
AUDIO_BACKGROUND_MUSIC=false
AUDIO_BACKGROUND_MUSIC_VOLUME=0.16
# AUDIO_BACKGROUND_MUSIC_PATH=data/audio/music/chill_loop.wav

# Optional: Telegram connection through SOCKS proxy
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:2080
# TELEGRAM_PROXY_URL=socks5://username:password@127.0.0.1:2080

# Optional: comma-separated override for config/channels.txt
